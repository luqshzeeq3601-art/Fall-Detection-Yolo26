# ElderCare Vision — example environment (P0-005). Copy to `.env` and fill in
# real LOCAL values; never commit a filled `.env` file or real secrets.
# Every key mirrors a field of `eldercare.common.settings.Settings` exactly.
# DATABASE_URL precedence: a directly supplied (non-empty) DATABASE_URL wins;
# otherwise it is composed from the POSTGRES_* parts (same template as compose).

# Required: PostgreSQL username (fail-closed if missing). Must byte-match docker-compose.yml.
POSTGRES_USER=CHANGEME
# Required: PostgreSQL password (fail-closed if missing). Must byte-match docker-compose.yml.
POSTGRES_PASSWORD=CHANGEME
# Required: PostgreSQL database name (fail-closed if missing). Must byte-match docker-compose.yml.
POSTGRES_DB=CHANGEME
# Optional: direct database URL override (default: empty = composed from parts as
# postgresql://${POSTGRES_USER}:<password>@postgres:5432/${POSTGRES_DB} per docker-compose.yml).
DATABASE_URL=
# Optional: MQTT broker host (default: mosquitto).
MQTT_HOST=mosquitto
# Optional: MQTT broker port 1-65535 (default: 1883).
MQTT_PORT=1883
# Optional: MQTT site identifier (default: local-site).
MQTT_SITE_ID=local-site
# Optional: log level, one of DEBUG/INFO/WARNING/ERROR/CRITICAL (default: INFO).
LOG_LEVEL=INFO
# Optional: RTSP camera URL, empty means disabled (default: empty; format e.g. rtsp://<user>:<password>@<host>:554/<path>).
RTSP_URL=
# Optional: VLM provider API key, empty means enrichment disabled per NFR-025 (default: empty).
VLM_API_KEY=
